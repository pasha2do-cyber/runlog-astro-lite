---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import MediaWindow from '../../components/MediaWindow.astro';
import Cover from '../../components/Cover.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
const grid = rest.slice(0, 3);
const categories = ['all', ...new Set(posts.map((p) => p.data.category))];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC' });
const initials = (n: string) => n.split(' ').map((w) => w[0]).join('');
---

<Base title="Blog" description="Engineering, research and product notes from the team building Runlog.">
  <Section top={false} inner="px-6 pt-20 pb-10 max-md:px-5 max-md:pt-10 max-md:pb-6 overflow-hidden" label="Blog">
    <div class="grid-bg" style="--gx:85%;--gy:30%" aria-hidden="true"></div>
    <div class="relative flex flex-wrap items-end justify-between gap-8">
      <div>
        <p class="label"><b>[00]</b> blog</p>
        <h1 class="mt-5 text-[clamp(40px,5.6vw,64px)] leading-[1.02] font-bold tracking-[-0.045em]">Field notes.</h1>
        <p class="mt-5 max-w-[48ch] text-[16px] leading-[1.6] text-steel max-md:text-[14px]">Engineering, research and product notes from the team building Runlog.</p>
      </div>
      <label class="flex items-center gap-2.5 w-[360px] max-md:w-full border border-ink bg-canvas px-3.5 py-3 text-[13px]">
        <span class="font-bold text-ink" aria-hidden="true">/</span>
        <input type="search" placeholder="Search posts" class="flex-1 bg-transparent text-ink placeholder:text-smoke outline-none" data-post-search aria-label="Search posts" />
      </label>
    </div>
    <div class="relative mt-8 flex gap-2 overflow-x-auto max-md:-mx-5 max-md:px-5" role="group" aria-label="Filter by category">
      {categories.map((c, i) => <button type="button" data-cat={c} aria-pressed={i === 0 ? 'true' : 'false'} class="pill shrink-0 border border-rule !px-3.5 !py-1.5 text-steel capitalize">{c}</button>)}
    </div>
  </Section>

  <Section top={false} inner="px-6 pt-6 pb-16 max-md:px-5 max-md:pb-8" label="Featured post">
    <a href={`/blog/${featured.id}`} class="group grid lg:grid-cols-[700px_1fr] gap-12 max-lg:gap-5 items-center" data-post={featured.data.category} data-title={featured.data.title.toLowerCase()}>
      <MediaWindow title="fig. 01 / featured">
        {featured.data.cover ? <img src={featured.data.cover} alt="" class="aspect-[16/9] w-full object-cover" /> : <Cover kind={0} label="fig. 01" />}
      </MediaWindow>
      <div>
        <p class="flex items-center gap-2.5"><span class="pill bg-ink text-canvas uppercase tracking-[0.06em] !text-[11px]">{featured.data.category}</span><span class="text-[12px] font-bold text-cta">Featured</span></p>
        <h2 class="mt-4 text-[36px] max-md:text-[24px] leading-[1.1] font-bold tracking-[-0.035em] group-hover:underline underline-offset-[6px] decoration-2">{featured.data.title}</h2>
        <p class="mt-4 text-[15px] leading-[1.6] text-steel max-w-[48ch] max-md:hidden">{featured.data.excerpt}</p>
        <p class="mt-5 flex items-center gap-3"><span class="flex size-9 items-center justify-center rounded-full bg-ink text-canvas text-[11px] font-bold" aria-hidden="true">{initials(featured.data.author)}</span><span class="text-[13px]"><span class="block font-bold text-ink">{featured.data.author}</span><span class="text-smoke">{fmt(featured.data.date)} · {featured.data.readingTime} min read</span></span></p>
      </div>
    </a>
  </Section>

  <Section top={false} inner="px-6 pb-20 max-md:px-5 max-md:pb-10" label="Latest posts">
    <ul class="grid lg:grid-cols-3 border border-rule max-lg:border-x-0 max-lg:border-t-0">
      {grid.map((p, i) => (
        <li class:list={['max-lg:border-t max-lg:border-rule', i > 0 && 'lg:border-l lg:border-rule']} data-post={p.data.category} data-title={p.data.title.toLowerCase()}>
          <a href={`/blog/${p.id}`} class="group flex lg:flex-col gap-4 p-5 max-lg:px-0 max-lg:py-4">
            <span class="max-lg:w-[110px] max-lg:shrink-0">{p.data.cover ? <img src={p.data.cover} alt="" class="aspect-[16/9] w-full object-cover" /> : <Cover kind={i + 1} label={`fig. 0${i + 2}`} />}</span>
            <span>
              <span class="pill border border-rule text-steel uppercase tracking-[0.06em] !text-[10px]">{p.data.category}</span>
              <span class="block mt-3 text-[19px] max-lg:text-[14px] font-bold tracking-[-0.015em] leading-[1.25] text-ink group-hover:underline underline-offset-4">{p.data.title}</span>
              <span class="block mt-2 text-[12px] text-smoke">{fmt(p.data.date)} · {p.data.readingTime} min</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section label="All posts">
    <div class="flex items-end"><p class="label"><b>[01]</b> all posts</p><span class="ml-auto text-[12px] text-smoke">{posts.length} posts</span></div>
    <ul class="mt-6 border-t border-rule">
      {posts.map((p) => (
        <li data-post={p.data.category} data-title={p.data.title.toLowerCase()}>
          <a href={`/blog/${p.id}`} class="group grid grid-cols-[140px_130px_1fr_auto_auto] max-md:grid-cols-[1fr_auto] gap-x-6 gap-y-1 items-center py-[18px] border-b border-rule">
            <time class="text-[13px] text-smoke max-md:order-2 max-md:col-span-2" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            <span class="text-[11px] uppercase tracking-[0.06em] text-steel max-md:hidden">{p.data.category}</span>
            <span class="text-[16px] max-md:text-[15px] text-ink group-hover:underline underline-offset-4">{p.data.title}</span>
            <span class="text-[12px] text-smoke max-md:hidden">{p.data.readingTime} min</span>
            <span class="text-stone font-bold group-hover:text-ink" aria-hidden="true">-&gt;</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section mode="warm" inner="px-6 py-[72px] max-md:px-5 max-md:py-12" label="Newsletter">
    <div class="flex flex-wrap items-center justify-between gap-8">
      <div>
        <p class="label"><b>[02]</b> newsletter</p>
        <h2 class="mt-3 text-[32px] max-md:text-[24px] font-bold tracking-[-0.03em]">Field notes, monthly.</h2>
        <p class="mt-2 text-[15px] text-steel">One email. No launches dressed up as insights.</p>
      </div>
      <form action="https://runlog-astro.pages.dev/contact" method="get" class="flex max-md:flex-col w-[480px] max-md:w-full border border-ink bg-canvas">
        <label class="sr-only" for="nl-email">Email</label>
        <input id="nl-email" type="email" required placeholder="you@example.com" class="flex-1 min-w-0 px-4 py-3.5 text-[14px] bg-transparent text-ink placeholder:text-smoke outline-none" />
        <button class="btn btn-inverse">Subscribe</button>
      </form>
    </div>
  </Section>
</Base>

<style>
  [data-cat][aria-pressed='true'] { background: var(--ink); color: var(--canvas); border-color: var(--ink); font-weight: 700; }
</style>

<script>
  let cat = 'all', q = '';
  const apply = () => document.querySelectorAll<HTMLElement>('[data-post]').forEach((el) => {
    el.hidden = (cat !== 'all' && el.dataset.post !== cat) || (!!q && !el.dataset.title!.includes(q));
  });
  document.querySelectorAll<HTMLButtonElement>('[data-cat]').forEach((b) => b.addEventListener('click', () => {
    cat = b.dataset.cat!;
    document.querySelectorAll('[data-cat]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  }));
  document.querySelector<HTMLInputElement>('[data-post-search]')?.addEventListener('input', (e) => { q = (e.target as HTMLInputElement).value.trim().toLowerCase(); apply(); });
</script>
