---
interface Props { idx: string; label: string; title: string; lede?: string; size?: 'md' | 'lg' }
const { idx, label, title, lede, size = 'md' } = Astro.props;
---

<div class="max-w-[760px]">
  <p class="label"><b>[{idx}]</b> {label}</p>
  <h2 class:list={['mt-4 font-bold leading-[1.1] tracking-[-0.035em] whitespace-pre-line', size === 'lg' ? 'text-[clamp(36px,5vw,64px)]' : 'text-[clamp(28px,3.4vw,40px)]']}>{title}</h2>
  {lede && <p class="mt-4 text-[15px] leading-[1.6] text-steel max-w-[56ch]">{lede}</p>}
</div>
