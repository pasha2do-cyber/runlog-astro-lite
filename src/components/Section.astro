---
// A full-bleed band holding the 1280px framed column.
// mode: 'invert' = black band on light theme (light on dark), 'warm' = warm accent band.
interface Props { id?: string; mode?: 'invert' | 'warm'; class?: string; inner?: string; top?: boolean; label?: string }
const { id, mode, class: cls, inner = 'px-6 py-24 max-md:px-5 max-md:py-14', top = true, label } = Astro.props;
---

<section id={id} aria-label={label} class:list={[mode === 'invert' && 'band-invert', mode === 'warm' && 'band-warm', cls]}>
  <div class:list={['frame relative', top && 'border-t border-rule', inner]}>
    <slot />
  </div>
</section>
