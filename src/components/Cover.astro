---
// Placeholder cover art for posts without an image. kind 0-3 picks the figure.
interface Props { kind?: number; label?: string; class?: string }
const { kind = 0, label = '', class: cls } = Astro.props;
const bars = [0.4, 0.62, 0.3, 0.7, 0.5, 0.45, 0.66, 0.25, 0.6];
const pts = [[10, 70], [30, 55], [45, 62], [62, 35], [80, 42], [92, 20]];
---

<div class:list={['relative aspect-[16/9] bg-tint overflow-hidden', cls]} role="img" aria-label={label || 'Cover illustration'}>
  <div class="absolute inset-0" style="background-image:linear-gradient(to right,var(--rule) 1px,transparent 1px),linear-gradient(to bottom,var(--rule) 1px,transparent 1px);background-size:24px 24px" aria-hidden="true"></div>
  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 56.25" preserveAspectRatio="xMidYMid meet" fill="none" aria-hidden="true">
    {kind === 0 && <>
      <rect x="32" y="10" width="36" height="36" stroke="var(--ink)" stroke-width="0.3" />
      <rect x="38.5" y="16.5" width="23" height="23" stroke="var(--cta)" stroke-width="0.3" />
      <rect x="44" y="22" width="12" height="12" stroke="var(--ink)" stroke-width="0.3" />
      <rect x="49" y="27" width="2" height="2" fill="var(--cta)" />
    </>}
    {kind === 1 && bars.map((h, i) => <rect x={30 + i * 4.6} y={46 - h * 36} width="2.6" height={h * 36} fill={i === 6 ? 'var(--cta)' : 'var(--ink)'} />)}
    {kind === 2 && <>
      <circle cx="50" cy="28" r="16" stroke="var(--ink)" stroke-width="0.3" stroke-dasharray="1 1" />
      <rect x="59" y="14" width="2.4" height="2.4" fill="var(--cta)" stroke="var(--ink)" stroke-width="0.2" />
      <rect x="54" y="42" width="2.4" height="2.4" fill="var(--canvas)" stroke="var(--ink)" stroke-width="0.2" />
      <rect x="35" y="33" width="2.4" height="2.4" fill="var(--canvas)" stroke="var(--ink)" stroke-width="0.2" />
    </>}
    {kind === 3 && <>
      <polyline points={pts.map(([x, y]) => `${x},${y * 0.5625}`).join(' ')} stroke="var(--ink)" stroke-width="0.4" />
      {pts.map(([x, y], i) => <rect x={x - 1} y={y * 0.5625 - 1} width="2" height="2" fill={i === 3 ? 'var(--cta)' : 'var(--canvas)'} stroke="var(--ink)" stroke-width="0.2" />)}
    </>}
  </svg>
  {label && <span class="absolute left-3 bottom-2 text-[11px] text-smoke">{label}</span>}
</div>
