---
import { site } from '../data/site';
import Section from './Section.astro';
interface Props { title?: string; lede?: string }
const { title = 'Start your first run.', lede = 'Free for 10,000 steps a month. No card, no sales call.' } = Astro.props;
---

<Section mode="invert" inner="px-6 py-32 max-md:px-5 max-md:py-24 text-center overflow-hidden" label="Get started">
  <div class="grid-bg" style="--gx:50%;--gy:45%" aria-hidden="true"></div>
  <svg class="absolute inset-0 m-auto pointer-events-none max-md:scale-75" width="760" height="760" viewBox="0 0 760 760" fill="none" aria-hidden="true">
    <circle cx="380" cy="380" r="259.5" stroke="var(--stone)" />
    <circle cx="380" cy="380" r="379.5" stroke="var(--rule)" stroke-dasharray="3 5" />
    <rect x="630" y="324" width="8" height="8" fill="var(--cta)" />
    <rect x="76" y="608" width="8" height="8" fill="var(--cta)" />
  </svg>
  <div class="relative">
    <p class="label"><b>[10]</b> exit 0</p>
    <h2 class="mt-5 text-[clamp(44px,6vw,72px)] leading-none font-bold tracking-[-0.05em]">{title}</h2>
    <p class="mt-5 text-[16px] text-steel max-md:text-[14px]">{lede}</p>
    <div class="mt-9 flex flex-wrap justify-center items-center gap-x-7 gap-y-4 max-md:flex-col max-md:items-stretch">
      <a href={site.cta.href} class="btn btn-primary">{site.cta.label} -&gt;</a>
      <a href="https://runlog-astro.pages.dev" class="link text-[15px]">See Runlog Pro -&gt;</a>
    </div>
    <p class="mt-12 inline-flex items-center gap-2.5 border border-rule bg-tint px-4 py-3 text-[13px] text-ink">
      $ runlog deploy triage-bot <span class="size-1.5 rounded-full bg-ok" aria-hidden="true"></span><span class="text-steel">live in 4.2s</span>
    </p>
  </div>
</Section>
