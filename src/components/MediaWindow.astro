---
// Product visual slot. Keep the chrome, replace the slot with your own screenshot,
// video or live widget: <MediaWindow title="app.yoursite.com"><img src=... /></MediaWindow>
interface Props { title: string; tag?: string; shadow?: boolean; class?: string }
const { title, tag = 'demo', shadow = false, class: cls } = Astro.props;
---

<figure class:list={['border border-ink bg-canvas', shadow && 'hard-shadow', cls]}>
  <figcaption class="flex items-center gap-3 h-9 px-3.5 border-b border-ink bg-tint text-[12px] text-smoke">
    <span class="flex gap-1.5" aria-hidden="true">{[0, 1, 2].map(() => <span class="size-2 border border-stone"></span>)}</span>
    <span class="truncate">{title}</span>
    {tag && <span class="ml-auto text-[11px] uppercase tracking-[0.08em]">{tag}</span>}
  </figcaption>
  <slot />
</figure>
