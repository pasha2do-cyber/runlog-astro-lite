---
// Segmented light / dark control. Any number of instances stay in sync.
---

<div class="theme-switch inline-flex border border-rule text-[12px]" role="group" aria-label="Color theme">
  {['light', 'dark'].map((t) => (
    <button type="button" data-set-theme={t} class="flex items-center gap-1.5 px-2.5 py-1 text-smoke">
      <span class:list={['size-[7px] border border-current', t === 'dark' && 'bg-current']} aria-hidden="true"></span>{t}
    </button>
  ))}
</div>

<style>
  :global(:root:not([data-theme='dark'])) [data-set-theme='light'],
  :global(:root[data-theme='dark']) [data-set-theme='dark'] { background: var(--ink); color: var(--canvas); font-weight: 700; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((b) =>
    b.addEventListener('click', () => {
      const t = b.dataset.setTheme!;
      document.documentElement.dataset.theme = t;
      try { localStorage.setItem('theme', t); } catch {}
    }),
  );
</script>
