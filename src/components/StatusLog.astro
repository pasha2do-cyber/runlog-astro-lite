---
// Small run log used on Thank you and 404. mark: '✓' done, 'x' failed, '...' pending.
import MediaWindow from './MediaWindow.astro';
interface Step { kind: string; text: string; time: string; mark: string; active?: boolean }
interface Props { title: string; id: string; status: string; tone?: 'ok' | 'badge'; steps: Step[] }
const { title, id, status, tone = 'ok', steps } = Astro.props;
---

<MediaWindow title={title} shadow class="w-full max-w-[620px] text-left text-[13px]">
  <div class="flex items-center h-11 px-4 border-b border-ink">
    <span class="text-ink font-bold">{id}</span>
    {tone === 'ok'
      ? <span class="ml-auto pill border border-rule text-steel"><span class="size-1.5 rounded-full bg-ok" aria-hidden="true"></span>{status}</span>
      : <span class="ml-auto pill bg-badge text-black">{status}</span>}
  </div>
  <ol class="py-1.5">
    {steps.map((s, i) => (
      <li class:list={['grid grid-cols-[2.5ch_6ch_1fr_auto_2ch] max-sm:grid-cols-[2.5ch_1fr_auto_2ch] items-center gap-3 px-4 h-9', s.active && 'bg-tint']}>
        <span class="text-smoke">{String(i + 1).padStart(2, '0')}</span>
        <span class="text-smoke max-sm:hidden">{s.kind}</span>
        <span class="text-ink truncate">{s.text}</span>
        <span class="text-smoke tabular-nums">{s.time}</span>
        <span class:list={['text-right font-bold', s.mark === '✓' ? 'text-ok' : s.mark === 'x' ? 'text-cta' : 'text-smoke']}>{s.mark}</span>
      </li>
    ))}
  </ol>
</MediaWindow>
